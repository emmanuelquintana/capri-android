<?xml version="1.0" encoding="utf-8"?>
<!-- her HUD: ink, a thin mane-red frame, and her yellow echo under it -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#F6EC00" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#13120D" />
            <stroke android:width="1.5dp" android:color="#FA0448" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
