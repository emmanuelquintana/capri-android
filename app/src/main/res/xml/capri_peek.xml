<?xml version="1.0" encoding="utf-8"?>
<!-- Capri peeking in your notification panel (PeekService.kt): it's only told that Android's own panel
     (com.android.systemui) opened. No window content, no gestures, no other app. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:packageNames="com.android.systemui"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="300"
    android:canRetrieveWindowContent="false"
    android:description="@string/peek_service_desc"
    android:summary="@string/peek_service_summary" />
