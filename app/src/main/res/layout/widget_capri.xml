<?xml version="1.0" encoding="utf-8"?>
<!-- Capri's widget: her face, her name, how she is, and four quick things (CapriWidget.kt) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_face"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_face_bg"
            android:contentDescription="@string/app_name"
            android:padding="2dp"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:text="/// PROJECT CAPRICORN"
                android:textColor="#FA0448"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/w_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:text="CAPRI"
                android:textColor="#F6EC00"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="@string/widget_off"
                android:textColor="#FF2052"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_main"
            style="@style/WidgetButton"
            android:background="@drawable/widget_btn"
            android:text="@string/widget_start"
            android:textColor="#13120D" />

        <TextView
            android:id="@+id/w_look"
            style="@style/WidgetButton"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_line"
            android:text="@string/widget_look"
            android:textColor="#36FF7A" />

        <TextView
            android:id="@+id/w_dress"
            style="@style/WidgetButton"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_line"
            android:text="@string/widget_dress"
            android:textColor="#36FF7A" />

        <TextView
            android:id="@+id/w_toggle"
            style="@style/WidgetButton"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_line"
            android:text="@string/widget_hide"
            android:textColor="#36FF7A" />
    </LinearLayout>
</LinearLayout>
